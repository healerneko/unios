#!/bin/busybox sh
export PATH=/usr/bin:/bin:/sbin
export HOME=/root
export TERM=linux

mkdir -p /dev /proc /sys /run /tmp /root /mnt/UniOS /usr/share/udhcpc
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null
exec </dev/console >/dev/console 2>&1
/bin/busybox mount -t proc proc /proc 2>/dev/null
/bin/busybox mount -t sysfs sysfs /sys 2>/dev/null
/bin/busybox mount -t tmpfs -o mode=1777 tmpfs /tmp 2>/dev/null

echo /sbin/modprobe > /proc/sys/kernel/modprobe 2>/dev/null
echo "[ OK ] Kernel Linux CachyOS iniciado"
echo "[....] Carregando drivers de armazenamento e rede"
for module in scsi_mod sd_mod usbcore xhci_hcd ehci_hcd uhci_hcd usb_storage uas ahci ata_piix rndis_host e1000 8139too vfat; do
    /bin/busybox modprobe "$module" >/dev/null 2>&1 || true
done
/bin/busybox mdev -s 2>/dev/null

# Give USB/SCSI devices time to enumerate. Never probe or write to fixed
# /dev/sda1: it may be the host's internal EFI partition.
mounted=0
attempt=0
while [ "$attempt" -lt 10 ] && [ "$mounted" -eq 0 ]; do
    for disk in /sys/block/*; do
        [ -r "$disk/removable" ] || continue
        [ "$(cat "$disk/removable" 2>/dev/null)" = "1" ] || continue
        disk_name=${disk##*/}
        for partition in /sys/block/"$disk_name"/"$disk_name"*; do
            [ -e "$partition/partition" ] || continue
            part_name=${partition##*/}
            device="/dev/$part_name"
            [ -b "$device" ] || continue
            if /bin/busybox mount -t vfat -o rw "$device" /mnt/UniOS 2>/dev/null; then
                echo "[ OK ] Midia USB removivel montada: $device"
                mounted=1
                break
            fi
        done
        [ "$mounted" -eq 1 ] && break
    done
    [ "$mounted" -eq 1 ] && break
    /bin/busybox sleep 1
    attempt=$((attempt + 1))
    /bin/busybox mdev -s 2>/dev/null
done

network_up=0
for path in /sys/class/net/*; do
    iface=${path##*/}
    [ "$iface" = lo ] && continue
    /bin/busybox ip link set "$iface" up 2>/dev/null || continue
    echo "[....] DHCP em $iface"
    if /bin/busybox udhcpc -i "$iface" -n -q -t 5 -T 2 -s /usr/share/udhcpc/default.script >/dev/null 2>&1; then
        echo "[ OK ] Rede configurada em $iface"
        network_up=1
        break
    fi
done

{
    echo "UniOS Linux Live"
    echo "Kernel: $(/bin/busybox uname -r)"
    echo "Dispositivos de bloco:"
    for disk in /sys/block/*; do
        [ -e "$disk" ] || continue
        echo "${disk##*/}: removivel=$(cat "$disk/removable" 2>/dev/null)"
    done
    echo ""
    /bin/busybox dmesg
} > /tmp/UniOS.log 2>&1
if [ "$mounted" -eq 1 ]; then
    /bin/busybox cp /tmp/UniOS.log /mnt/UniOS/UNIOS.LOG 2>/dev/null
fi

if [ "$network_up" -eq 1 ]; then
    echo "[ OK ] Rede pronta; teste ping e wget"
else
    echo "[FAIL] Rede sem DHCP; confira cabo/ancoragem USB"
fi
if [ "$mounted" -eq 0 ]; then
    echo "[AVISO] Nenhuma particao FAT32 removivel foi encontrada."
    echo "[INFO] O log de diagnostico esta em /tmp/UniOS.log"
fi
echo ""
echo "Bem-vindo ao UniOS Linux Live"
echo "Digite help para ver os comandos. Use exit para voltar ao menu de boot."
echo ""

while :; do
    /bin/busybox ash -l -i
    echo "O shell foi fechado. Reiniciando o UniOS..."
    /bin/busybox reboot -f
    /bin/busybox sleep 2
done
